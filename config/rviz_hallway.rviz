# RViz Config for Hallway Digital Twin
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
    - Class: rviz_default_plugins/LaserScan
      Topic:
        Value: /scan
      Size (m): 0.1
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Enabled: true
      Name: LiDAR
  Global Options:
    Fixed Frame: world
    Publish transform: true
  Window Geometry:
    Height: 800
    Width: 1200