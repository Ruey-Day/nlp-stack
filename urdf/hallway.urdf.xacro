<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hallway">

  <!-- Parameters -->
  <xacro:property name="length" value="10.0" />    <!-- hallway length (m) -->
  <xacro:property name="width" value="2.5" />      <!-- hallway internal width -->
  <xacro:property name="height" value="2.8" />     <!-- ceiling height -->
  <xacro:property name="thickness" value="0.1" />  <!-- wall thickness -->

  <!-- inertial helper macro -->
  <xacro:macro name="box_inertial" params="mass lx ly lz">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${mass}0.083" ixy="0.0" ixz="0.0" iyy="${mass}0.083" iyz="0.0" izz="${mass}0.083"/>
    </inertial>
  </xacro:macro>

  <!-- Floor -->
  <link name="floor_link">
    <visual>
      <geometry>
        <box size="${length} ${width} ${thickness}"/>
      </geometry>
      <origin xyz="${length/2} 0 ${-thickness/2}" rpy="0 0 0"/>
      <material name="Grey">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${length} ${width} ${thickness}"/>
      </geometry>
      <origin xyz="${length/2} 0 ${-thickness/2}" rpy="0 0 0"/>
    </collision>
    <xacro:box_inertial mass="10" lx="${length}" ly="${width}" lz="${thickness}"/>
  </link>

  <!-- Left wall -->
  <link name="left_wall_link">
    <visual>
      <geometry>
        <box size="${length} ${thickness} ${height}"/>
      </geometry>
      <origin xyz="${length/2} ${width/2 + thickness/2} ${height/2 - thickness/2}" rpy="0 0 0"/>
      <material name="Wall">
        <color rgba="0.9 0.9 0.95 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${length} ${thickness} ${height}"/>
      </geometry>
      <origin xyz="${length/2} ${width/2 + thickness/2} ${height/2 - thickness/2}" rpy="0 0 0"/>
    </collision>
    <xacro:box_inertial mass="8" lx="${length}" ly="${thickness}" lz="${height}"/>
  </link>

  <!-- Right wall -->
  <link name="right_wall_link">
    <visual>
      <geometry>
        <box size="${length} ${thickness} ${height}"/>
      </geometry>
      <origin xyz="${length/2} ${-width/2 - thickness/2} ${height/2 - thickness/2}" rpy="0 0 0"/>
      <material name="Wall2">
        <color rgba="0.95 0.9 0.9 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${length} ${thickness} ${height}"/>
      </geometry>
      <origin xyz="${length/2} ${-width/2 - thickness/2} ${height/2 - thickness/2}" rpy="0 0 0"/>
    </collision>
    <xacro:box_inertial mass="8" lx="${length}" ly="${thickness}" lz="${height}"/>
  </link>

  <!-- Ceiling -->
  <link name="ceiling_link">
    <visual>
      <geometry>
        <box size="${length} ${width} ${thickness}"/>
      </geometry>
      <origin xyz="${length/2} 0 ${height + thickness/2 - thickness}" rpy="0 0 0"/>
      <material name="Ceiling">
        <color rgba="0.95 0.95 0.95 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${length} ${width} ${thickness}"/>
      </geometry>
      <origin xyz="${length/2} 0 ${height + thickness/2 - thickness}" rpy="0 0 0"/>
    </collision>
    <xacro:box_inertial mass="6" lx="${length}" ly="${width}" lz="${thickness}"/>
  </link>

  <!-- Simple 'robot' with camera for visualization (optional) -->
  <link name="camera_base">
    <visual>
      <geometry><box size="0.2 0.2 0.1"/></geometry>
      <origin xyz="0.5 0 0.5" rpy="0 0 0"/>
      <material><color rgba="0.2 0.6 0.8 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.2 0.2 0.1"/></geometry>
      <origin xyz="0.5 0 0.5" rpy="0 0 0"/>
    </collision>
    <xacro:box_inertial mass="1" lx="0.2" ly="0.2" lz="0.1"/>
  </link>

  <!-- joint connections (fix them to world) -->
  <joint name="floor_fixed" type="fixed">
    <parent link="world"/>
    <child link="floor_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="left_wall_fixed" type="fixed">
    <parent link="world"/>
    <child link="left_wall_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="right_wall_fixed" type="fixed">
    <parent link="world"/>
    <child link="right_wall_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="ceiling_fixed" type="fixed">
    <parent link="world"/>
    <child link="ceiling_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="camera_fixed" type="fixed">
    <parent link="world"/>
    <child link="camera_base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Optionally add a simple camera sensor plugin for Gazebo (requires gazebo camera plugins)
       Uncomment only if you have gazebo camera plugins available.
  <gazebo reference="camera_base">
    <sensor type="camera" name="hallway_camera">
      <pose>0 0 0.05 0 0 0</pose>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>100</far>
        </clip>
      </camera>
      <update_rate>30</update_rate>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/hallway</namespace>
        </ros>
        <cameraName>hallway_camera</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
      </plugin>
    </sensor>
  </gazebo>
  -->

</robot>
