<?xml version="1.0" ?>
<sdf version="1.8">
    <world name="hallway_world">
        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>
        
        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!-- Ceiling Lights -->
        <light type="point" name="ceiling_light_1">
            <pose>-3 0 2.3 0 0 0</pose>
            <diffuse>0.9 0.9 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <attenuation>
                <range>8</range>
                <constant>0.5</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
        </light>

        <light type="point" name="ceiling_light_2">
            <pose>2 0 2.3 0 0 0</pose>
            <diffuse>0.9 0.9 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <attenuation>
                <range>8</range>
                <constant>0.5</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
        </light>

        <light type="point" name="ceiling_light_3">
            <pose>7 0 2.3 0 0 0</pose>
            <diffuse>0.9 0.9 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <attenuation>
                <range>8</range>
                <constant>0.5</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
        </light>

        <light type="point" name="ceiling_light_4">
            <pose>10 3 2.3 0 0 0</pose>
            <diffuse>0.9 0.9 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <attenuation>
                <range>8</range>
                <constant>0.5</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
        </light>

        <!-- ========== FLOORS ========== -->
        
        <!-- Main Hallway Floor: from x=-6 to x=10, y=-1.5 to y=1.5 -->
        <model name="floor_main">
            <static>true</static>
            <pose>2 0 0 0 0 0</pose>
            <link name="floor_link">
                <collision name="floor_collision">
                    <geometry>
                        <box>
                            <size>16.0 3.0 0.01</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="floor_visual">
                    <geometry>
                        <box>
                            <size>16.0 3.0 0.01</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.5 0.5 0.5 1</ambient>
                        <diffuse>0.7 0.7 0.7 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Cross Hallway Floor: from x=8.5 to x=11.5, y=1.5 to y=8.5 -->
        <model name="floor_cross">
            <static>true</static>
            <pose>10 5 0 0 0 0</pose>
            <link name="floor_link">
                <collision name="floor_collision">
                    <geometry>
                        <box>
                            <size>3.0 7.0 0.01</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="floor_visual">
                    <geometry>
                        <box>
                            <size>3.0 7.0 0.01</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.5 0.5 0.5 1</ambient>
                        <diffuse>0.7 0.7 0.7 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- ========== MAIN HALLWAY WALLS ========== -->
        
        <!-- Main Hallway - Left Wall (Red): y=1.5, x from -6 to 10 -->
        <model name="wall_main_left">
            <static>true</static>
            <pose>2 1.5 1.25 0 0 0</pose>
            <link name="wall_link">
                <collision name="wall_collision">
                    <geometry>
                        <box>
                            <size>16.0 0.1 2.5</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="wall_visual">
                    <geometry>
                        <box>
                            <size>16.0 0.1 2.5</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.8 0.1 0.1 1</ambient>
                        <diffuse>0.8 0.1 0.1 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Main Hallway - Right Wall (Brown) - Part 1: y=-1.5, x from -6 to 1 -->
        <model name="wall_main_right_1">
            <static>true</static>
            <pose>-2.5 -1.5 1.25 0 0 0</pose>
            <link name="wall_link">
                <collision name="wall_collision">
                    <geometry>
                        <box>
                            <size>7.0 0.1 2.5</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="wall_visual">
                    <geometry>
                        <box>
                            <size>7.0 0.1 2.5</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.5 0.3 0.1 1</ambient>
                        <diffuse>0.5 0.3 0.1 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Main Hallway - Right Wall - Part 2: y=-1.5, x from 3 to 10 -->
        <model name="wall_main_right_2">
            <static>true</static>
            <pose>6.5 -1.5 1.25 0 0 0</pose>
            <link name="wall_link">
                <collision name="wall_collision">
                    <geometry>
                        <box>
                            <size>7.0 0.1 2.5</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="wall_visual">
                    <geometry>
                        <box>
                            <size>7.0 0.1 2.5</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.5 0.3 0.1 1</ambient>
                        <diffuse>0.5 0.3 0.1 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Main Hallway - End Wall (Brown): x=10, y from -1.5 to 1.5 -->
        <model name="wall_main_end">
            <static>true</static>
            <pose>10 0 1.25 0 0 0</pose>
            <link name="wall_link">
                <collision name="wall_collision">
                    <geometry>
                        <box>
                            <size>0.1 3.0 2.5</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="wall_visual">
                    <geometry>
                        <box>
                            <size>0.1 3.0 2.5</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.5 0.3 0.1 1</ambient>
                        <diffuse>0.5 0.3 0.1 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- ========== CROSS HALLWAY WALLS ========== -->
        
        <!-- Cross Hallway - Left Wall (Blue): x=8.5, y from -1.5 to 8.5 -->
        <model name="wall_cross_left">
            <static>true</static>
            <pose>8.5 3.5 1.25 0 0 0</pose>
            <link name="wall_link">
                <collision name="wall_collision">
                    <geometry>
                        <box>
                            <size>0.1 10.0 2.5</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="wall_visual">
                    <geometry>
                        <box>
                            <size>0.1 10.0 2.5</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.2 0.5 0.8 1</ambient>
                        <diffuse>0.2 0.5 0.8 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Cross Hallway - Right Wall (Blue) Part 1: x=11.5, y from -1.5 to 5.5 (with door opening) -->
        <model name="wall_cross_right_1">
            <static>true</static>
            <pose>11.5 2 1.25 0 0 0</pose>
            <link name="wall_link">
                <collision name="wall_collision">
                    <geometry>
                        <box>
                            <size>0.1 7.0 2.5</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="wall_visual">
                    <geometry>
                        <box>
                            <size>0.1 7.0 2.5</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.2 0.5 0.8 1</ambient>
                        <diffuse>0.2 0.5 0.8 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Cross Hallway - Right Wall - Part 2: x=11.5, y from 6.5 to 8.5 -->
        <model name="wall_cross_right_2">
            <static>true</static>
            <pose>11.5 7.5 1.25 0 0 0</pose>
            <link name="wall_link">
                <collision name="wall_collision">
                    <geometry>
                        <box>
                            <size>0.1 2.0 2.5</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="wall_visual">
                    <geometry>
                        <box>
                            <size>0.1 2.0 2.5</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.2 0.5 0.8 1</ambient>
                        <diffuse>0.2 0.5 0.8 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Cross Hallway - End Wall: y=8.5, x from 8.5 to 11.5 -->
        <model name="wall_cross_end">
            <static>true</static>
            <pose>10 8.5 1.25 0 0 0</pose>
            <link name="wall_link">
                <collision name="wall_collision">
                    <geometry>
                        <box>
                            <size>3.0 0.1 2.5</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="wall_visual">
                    <geometry>
                        <box>
                            <size>3.0 0.1 2.5</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.2 0.5 0.8 1</ambient>
                        <diffuse>0.2 0.5 0.8 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Cross Hallway - Bottom Wall: y=-1.5, x from 8.5 to 11.5 -->
        <model name="wall_cross_bottom">
            <static>true</static>
            <pose>10 -1.5 1.25 0 0 0</pose>
            <link name="wall_link">
                <collision name="wall_collision">
                    <geometry>
                        <box>
                            <size>3.0 0.1 2.5</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="wall_visual">
                    <geometry>
                        <box>
                            <size>3.0 0.1 2.5</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.2 0.5 0.8 1</ambient>
                        <diffuse>0.2 0.5 0.8 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- ========== DOORS (SAME COLOR, DIFFERENT TRANSPARENCY) ========== -->
        
        <!-- BLUE GLASS DOORS - Same color, different transparency levels -->
        
        <!-- Door 1: 90% transparent (almost invisible) -->
        <model name="blue_glass_door_90">
            <static>true</static>
            <pose>2 -1.45 1.0 0 0 0</pose>
            <link name="door_link">
                <collision name="door_collision">
                    <geometry>
                        <box>
                            <size>1.0 0.05 2.0</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="door_visual">
                    <geometry>
                        <box>
                            <size>1.0 0.05 2.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.5 0.8 1</ambient>
                        <diffuse>0.3 0.5 0.8 1</diffuse>
                        <specular>0.9 0.9 0.9 1</specular>
                    </material>
                    <transparency>0.9</transparency>
                </visual>
            </link>
        </model>

        <!-- Door 2: 70% transparent (clear glass) -->
        <model name="blue_glass_door_70">
            <static>true</static>
            <pose>5 1.55 1.0 0 0 1.57</pose>
            <link name="door_link">
                <collision name="door_collision">
                    <geometry>
                        <box>
                            <size>1.0 0.05 2.0</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="door_visual">
                    <geometry>
                        <box>
                            <size>1.0 0.05 2.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.5 0.8 1</ambient>
                        <diffuse>0.3 0.5 0.8 1</diffuse>
                        <specular>0.9 0.9 0.9 1</specular>
                    </material>
                    <transparency>0.7</transparency>
                </visual>
            </link>
        </model>

        <!-- Door 3: 50% transparent (frosted) -->
        <model name="blue_glass_door_50">
            <static>true</static>
            <pose>11.45 6 1.0 0 0 0</pose>
            <link name="door_link">
                <collision name="door_collision">
                    <geometry>
                        <box>
                            <size>1.0 0.05 2.0</size>
                        </box>
                    </geometry>
