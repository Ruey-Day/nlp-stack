                    <material>
                        <ambient>0.3 0.5 0.8 1</ambient>
                        <diffuse>0.3 0.5 0.8 1</diffuse>
                        <specular>0.9 0.9 0.9 1</specular>
                    </material>
                    <transparency>0.0</transparency>
                </visual>
            </link>
        </model>

        <!-- ========== OBSTACLES & FURNITURE ========== -->
        
        <!-- Pillar 1 (Square) -->
        <model name="pillar_1">
            <static>true</static>
            <pose>0 0.5 1.25 0 0 0</pose>
            <link name="pillar_link">
                <collision name="pillar_collision">
                    <geometry>
                        <box>
                            <size>0.5 0.5 2.5</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="pillar_visual">
                    <geometry>
                        <box>
                            <size>0.5 0.5 2.5</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.4 0.4 0.4 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Pillar 2 (Cylindrical) -->
        <model name="pillar_2">
            <static>true</static>
            <pose>-3.0 -0.8 1.25 0 0 0</pose>
            <link name="pillar_link">
                <collision name="pillar_collision">
                    <geometry>
                        <cylinder>
                            <radius>0.3</radius>
                            <length>2.5</length>
                        </cylinder>
                    </geometry>
                </collision>
                <visual name="pillar_visual">
                    <geometry>
                        <cylinder>
                            <radius>0.3</radius>
                            <length>2.5</length>
                        </cylinder>
                    </geometry>
                    <material>
                        <ambient>0.3 0.3 0.3 1</ambient>
                        <diffuse>0.4 0.4 0.4 1</diffuse>
                        <specular>0.2 0.2 0.2 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Room Divider / Partial Wall -->
        <model name="room_divider">
            <static>true</static>
            <pose>-1 0 0.75 0 0 0</pose>
            <link name="divider_link">
                <collision name="divider_collision">
                    <geometry>
                        <box>
                            <size>0.1 2.0 1.5</size>
                        </box>
