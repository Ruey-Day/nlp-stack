                    </geometry>
                    <material>
                        <ambient>0.3 0.5 0.8 1</ambient>
                        <diffuse>0.3 0.5 0.8 1</diffuse>
                        <specular>0.9 0.9 0.9 1</specular>
                    </material>
                    <transparency>0.5</transparency>
                </visual>
            </link>
        </model>

        <!-- Door 4: 30% transparent (tinted) -->
        <model name="blue_glass_door_30">
            <static>true</static>
            <pose>7 1.55 1.0 0 0 1.57</pose>
            <link name="door_link">
                <collision name="door_collision">
                    <geometry>
                        <box>
                            <size>1.0 0.05 2.0</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="door_visual">
                    <geometry>
                        <box>
                            <size>1.0 0.05 2.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.3 0.5 0.8 1</ambient>
                        <diffuse>0.3 0.5 0.8 1</diffuse>
                        <specular>0.9 0.9 0.9 1</specular>
                    </material>
                    <transparency>0.3</transparency>
                </visual>
            </link>
        </model>

        <!-- Door 5: 0% transparent (opaque - solid blue panel) -->
        <model name="blue_glass_door_00">
            <static>true</static>
            <pose>9 1.55 1.0 0 0 1.57</pose>
            <link name="door_link">
                <collision name="door_collision">
                    <geometry>
                        <box>
                            <size>1.0 0.05 2.0</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="door_visual">
                    <geometry>
                        <box>
                            <size>1.0 0.05 2.0</size>
