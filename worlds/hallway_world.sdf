                    </material>
                </visual>
            </link>
        </model>

        <!-- Small Table -->
        <model name="small_table">
            <static>true</static>
            <pose>10 6.5 0.4 0 0 0</pose>
            <link name="table_link">
                <collision name="table_collision">
                    <geometry>
                        <box>
                            <size>0.8 0.8 0.8</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="table_visual">
                    <geometry>
                        <box>
                            <size>0.8 0.8 0.8</size>
